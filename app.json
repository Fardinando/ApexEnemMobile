{
  "expo": {
    "name": "ApexEnem",
    "slug": "apexenem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apexenem",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexenem.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1b1b24"
      },
      "package": "com.apexenem.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para enviar redações",
          "cameraPermission": "Permitir acesso à câmera para fotografar redações"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
