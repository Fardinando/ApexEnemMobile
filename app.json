{
  "expo": {
    "name": "ApexEnem",
    "slug": "apexenem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apexenem",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1b1b24",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexenem.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1b24",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.apexenem.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para enviar redações",
          "cameraPermission": "Permitir acesso à câmera para fotografar redações"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
